theme = GitHub Dark Dimmed
#theme = Afterglow

# font-family = JetBrainsMono Nerd Font Mono
# font-family = JetBrains Mono
# font-feature = -calt
 
font-family = Maple Mono NF
font-size = 14
font-feature = +cv01
# font-feature = -calt
font-feature = +cv01 # Remove gaps
font-feature = +cv62 # Alternative question
font-feature = +cv34 # Alternative italic k
font-feature = +cv35 # Alternative italic l
font-feature = +cv36 # Alternative italic x
font-feature = +cv37 # Alternative italic y
font-feature = -ss03 # Disable Arbitrary tag


# font-family = Mononoki Nerd Font Mono
# font-family = mononoki
# font-size = 16

# font-family = Symbols Nerd Font Mono

# font-family = Monaspace Neon NF
# font-size = 15
# font-feature = +calts
# font-feature = +liga
# font-feature = +ss01
# font-feature = +ss02
# font-feature = +ss03
# font-feature = +ss07
# font-feature = +ss09

macos-icon = chalkboard
macos-titlebar-proxy-icon = hidden
title = " "

macos-option-as-alt = true

quit-after-last-window-closed = true

bell-features = no-title

